# Cigar Journal — environment. Copy to `.env` for local dev; the deploy sets
# these via its ExternalSecret (1Password). See ADR-004 for the auth model.

# Postgres connection string. The migrate runner and the app read this; @cj/db
# opens no connection until first query.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cigar_journal

# Better Auth signing secret (sessions, tokens). Generate a long random value,
# e.g. `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Public origin of the web app. Better Auth trusts this origin and builds
# callback URLs from it.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails allowed to register in Phase 1; each bootstraps to the
# `admin` role. Everyone else is rejected until the Phase 3 invite system lands.
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- MCP server (@cj/mcp) role. Shares DATABASE_URL + BETTER_AUTH_URL above. ---
# Port the MCP server listens on (GET /healthz, Streamable HTTP at /mcp).
PORT=8081
# Set true only to make /mcp reply as application/json instead of an SSE stream
# (test/debug convenience). Leave unset in production — clients negotiate SSE.
# MCP_JSON_RESPONSE=false
