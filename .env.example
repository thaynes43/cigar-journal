# Cigar Journal — environment. Copy to `.env` for local dev; the deploy sets
# these via its ExternalSecret (1Password). See ADR-004 for the auth model.

# Postgres connection string. The migrate runner and the app read this; @cj/db
# opens no connection until first query.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cigar_journal

# Better Auth signing secret (sessions, tokens). Generate a long random value,
# e.g. `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Public origin of the web app. Better Auth trusts this origin and builds
# callback URLs from it.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails allowed to register in Phase 1; each bootstraps to the
# `admin` role. Everyone else is rejected until the Phase 3 invite system lands.
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- MCP server (@cj/mcp) role. Shares DATABASE_URL + BETTER_AUTH_URL above. ---
# Port the MCP server listens on (GET /healthz, Streamable HTTP at /mcp).
PORT=8081
# Set true to make /mcp POST reply as application/json instead of an SSE stream.
# Production sets it (haynes-ops, since 2026-08-27) to cut per-call overhead.
# MCP_JSON_RESPONSE=false
# Minutes an MCP session may sit with no request in flight before the
# once-a-minute sweep closes it; its next request then gets 404 and the client
# re-initializes (issue #339). Defaults to 30.
# MCP_SESSION_IDLE_MINUTES=30

# --- Photo storage (ADR-007). Ceph RGW via ObjectBucketClaim in the deploy. ---
# Leave the whole block unset to disable photos: the journal core keeps working
# and the upload UI is hidden.
# S3 API endpoint of the RGW gateway (path-style addressing is forced).
PHOTOS_S3_ENDPOINT=http://rook-ceph-rgw-store.rook-ceph.svc:80
# Bucket name — the ObjectBucketClaim provisions this and injects the value.
PHOTOS_S3_BUCKET=cigar-journal-photos
# Credentials from the ObjectBucketClaim secret.
PHOTOS_S3_ACCESS_KEY_ID=replace-me
PHOTOS_S3_SECRET_ACCESS_KEY=replace-me
# Optional region; defaults to us-east-1 when unset (RGW ignores it).
# PHOTOS_S3_REGION=us-east-1
